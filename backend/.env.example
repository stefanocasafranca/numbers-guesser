# Application Configuration
APP_NAME="Numbers Guesser API"
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8080

# Firebase & Firestore Settings
FIREBASE_PROJECT_ID=numbers-guesser
# Path to service account JSON (optional; defaults to in-memory fallback if not found)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Local Firebase Emulator Settings (Uncomment if running firebase emulators:start)
# FIRESTORE_EMULATOR_HOST=localhost:8085
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Authentication Dev Bypass (Enables zero-friction local development)
DEV_BYPASS_AUTH=True
DEV_DEFAULT_USER_ID=dev-player-1
DEV_DEFAULT_USER_EMAIL=dev@numbersguesser.local

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
